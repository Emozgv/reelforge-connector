VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_...

# NEVER put the service_role key, a Stripe secret/restricted key, or the
# Stripe webhook signing secret here or in any VITE_* variable — anything
# prefixed VITE_ is bundled into the client and shipped to the browser.
# STRIPE_RESTRICTED_KEY and STRIPE_WEBHOOK_SECRET are Supabase Edge Function
# secrets (`supabase secrets set ...`), never a local .env value used by the
# client build. STRIPE_RESTRICTED_KEY is also read locally, once, only by
# scripts/stripe-setup.mjs — export it in your shell for that one run and
# unset it afterward; never commit it.
